<mujoco model="arm6_placeholder">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.001" integrator="RK4" gravity="0 0 0"/>

  <default>
    <joint type="hinge" limited="true" range="-3.14159 3.14159" damping="0.12" armature="0.02"/>
    <geom type="capsule" size="0.025" density="900" rgba="0.65 0.70 0.76 1"/>
    <motor ctrllimited="true" ctrlrange="-5 5" gear="1"/>
  </default>

  <worldbody>
    <light name="key" pos="0 -1 1.5" dir="0 1 -1"/>
    <geom name="floor" type="plane" pos="0 0 -0.02" size="1.2 1.2 0.02" rgba="0.18 0.19 0.20 1"/>

    <body name="base" pos="0 0 0">
      <geom name="base_geom" type="cylinder" size="0.08 0.04" rgba="0.20 0.22 0.25 1"/>

      <body name="link_1" pos="0 0 0.05">
        <joint name="joint_1" axis="0 0 1"/>
        <geom name="link_1_geom" fromto="0 0 0 0 0 0.20"/>

        <body name="link_2" pos="0 0 0.20">
          <joint name="joint_2" axis="0 1 0"/>
          <geom name="link_2_geom" fromto="0 0 0 0.18 0 0"/>

          <body name="link_3" pos="0.18 0 0">
            <joint name="joint_3" axis="0 1 0"/>
            <geom name="link_3_geom" fromto="0 0 0 0.16 0 0"/>

            <body name="link_4" pos="0.16 0 0">
              <joint name="joint_4" axis="1 0 0"/>
              <geom name="link_4_geom" fromto="0 0 0 0.12 0 0"/>

              <body name="link_5" pos="0.12 0 0">
                <joint name="joint_5" axis="0 1 0"/>
                <geom name="link_5_geom" fromto="0 0 0 0.09 0 0"/>

                <body name="link_6" pos="0.09 0 0">
                  <joint name="joint_6" axis="1 0 0"/>
                  <geom name="link_6_geom" fromto="0 0 0 0.06 0 0" rgba="0.85 0.55 0.24 1"/>
                  <site name="tool0" pos="0.07 0 0" size="0.015" rgba="0.95 0.95 0.95 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_1" joint="joint_1"/>
    <motor name="motor_2" joint="joint_2"/>
    <motor name="motor_3" joint="joint_3"/>
    <motor name="motor_4" joint="joint_4"/>
    <motor name="motor_5" joint="joint_5"/>
    <motor name="motor_6" joint="joint_6"/>
  </actuator>
</mujoco>
